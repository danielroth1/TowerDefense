{
  "name": "towerdefense",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tiles": "node --watch --watch-path=tools/tile-generator tools/tile-generator/server.mjs",
    "wang-tiles": "node tools/wang-tiles/generate-all.mjs",
    "wang-tiles:blend-crop": "node tools/wang-tiles/generate-all.mjs --blend-crop",
    "wang-tiles:blend-freq": "node tools/wang-tiles/generate-all.mjs --blend-freq",
    "wang-tiles:canonical": "node tools/wang-tiles/generate-all.mjs --canonical",
    "wang-tiles:coons": "node tools/wang-tiles/generate-all.mjs --coons",
    "wang-tiles:cutpaths": "node tools/wang-tiles/generate-all.mjs --cutpaths",
    "wang-tiles:diamond": "node tools/wang-tiles/generate-all.mjs --diamond",
    "wang-tiles:diamondcut": "node tools/wang-tiles/generate-all.mjs --diamondcut",
    "wang-tiles:quadrant": "node tools/wang-tiles/generate-all.mjs --quadrant",
    "wang-tiles:quilt": "node tools/wang-tiles/generate-all.mjs --quilt",
    "wang-tiles:strips": "node tools/wang-tiles/generate-all.mjs --strips"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "codebase-context": "^2.2.0",
    "phaser": "^3.60.0",
    "sharp": "^0.33.5"
  }
}
